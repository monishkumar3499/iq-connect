# Copy to .env and fill in. Every setting the service reads is listed here.
# Environment variables override .env.

# "dev" relaxes checks that only make sense in production (for example, an
# http://localhost PUBLIC_BASE_URL is allowed). Anything else means production.
APP_ENV=dev

# The address Claude and browsers use to reach this service, with no trailing
# slash. Claude connects from Anthropic's cloud, so for real testing this must
# be a public HTTPS URL such as a dev tunnel -- localhost only works for
# local tests. The connector URL you give Claude is PUBLIC_BASE_URL + /mcp.
PUBLIC_BASE_URL=http://localhost:8000

# Where the server listens (docker compose sets 0.0.0.0).
HOST=127.0.0.1
PORT=8000

# debug | info | warning | error
LOG_LEVEL=info

# Database, as a SQLAlchemy URL. SQLite (a single file) is fine for local work
# and a single copy of the service. Several copies need a server database:
#   PostgreSQL:  postgresql+psycopg://user:password@host:5432/iq
#   SQL Server:  mssql+pyodbc://user:password@host/iq?driver=ODBC+Driver+18+for+SQL+Server
# After changing it, create the tables with:  python -m backend.main migrate
# (docker compose sets this to its own PostgreSQL; see docker-compose.yml)
DATABASE_URL=sqlite:///.local/iq.db

# The key that encrypts stored platform logins. "local" keeps it in a file:
# created automatically in dev, required to exist elsewhere. Back the file up --
# losing it means everyone must sign in to their platforms again. Never commit
# it. (Azure Key Vault will be offered here later.)
KEY_PROVIDER=local
LOCAL_KEY_FILE=.local/keys.json
# Signs the access tokens we give Claude. Separate from the encryption key.
LOCAL_SIGNING_KEY_FILE=.local/signing_keys.json

# --- OAuth server (Claude signs in through us) ---
# Access tokens are signed and cannot be recalled, so keep them short.
ACCESS_TOKEN_MINUTES=60
# How long Claude stays connected without the person signing in again.
REFRESH_TOKEN_DAYS=30
# Hosts that registered clients may redirect to (comma separated). Loopback
# addresses used by Claude Code are always allowed.
OAUTH_REDIRECT_HOSTS=claude.ai,claude.com
# Client ID Metadata Documents (how Claude identifies itself). We only ever
# fetch them from these hosts; anything else would let callers make this
# server fetch arbitrary URLs. Set OAUTH_CIMD_ENABLED=false to force
# Claude to use dynamic registration instead (a diagnostic switch).
OAUTH_CIMD_ENABLED=true
OAUTH_CIMD_HOSTS=claude.ai,claude.com

# --- Signing people in to this service ---
# IQ Connect serves JMAN and its clients: people from ANY company sign in with their own
# Microsoft work account. The first sign-in creates their user (and an organisation per
# company / Entra tenant); later sign-ins open their own connections again.
# dev   = type any email, no password (only allowed with APP_ENV=dev)
# entra = "Sign in with Microsoft" with one MULTI-TENANT app registration (Azure portal ->
#         Microsoft Entra ID -> App registrations -> Supported account types: "Accounts in any
#         organizational directory"), a client secret, and these Web redirect URIs:
#           <PUBLIC_BASE_URL>/auth/callback/entra
#           <PUBLIC_BASE_URL>/auth/platform/entra/callback
#         Delegated API permissions: Power BI Service -> Workspace.Read.All, Item.Read.All,
#         Dataset.Read.All; Azure SQL Database -> user_impersonation; AzureDatabricks ->
#         user_impersonation. Each client company's admin consents once for their tenant.
SSO_PROVIDER=dev
# The ENTRA_* values may also be given as AZURE_TENANT_ID / AZURE_CLIENT_ID /
# AZURE_CLIENT_SECRET. Or leave them empty and enter the client ID and secret once at
# <PUBLIC_BASE_URL>/app/setup/microsoft (secret stored encrypted). Outside APP_ENV=dev that
# needs the setup code from the server window or  python -m backend.main microsoft-setup-code
# Set ENTRA_CLIENT_ID and ENTRA_CLIENT_SECRET together or not at all.
# "organizations" (default) = any company may sign in. A tenant GUID = only that company.
# SSO_ALLOWED_TENANTS (comma-separated tenant GUIDs) narrows "organizations" to a list.
ENTRA_TENANT=organizations
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
SSO_ALLOWED_TENANTS=
# Server operators (comma-separated emails). They become IQ admins when they sign in and may
# replace the Microsoft app entered in the UI. Nobody else ever becomes an admin.
ADMIN_EMAILS=
# How long a browser stays signed in to our pages.
SESSION_HOURS=8

# --- Microsoft Fabric ---
# Nothing to set: people choose in Add a new connection how to sign in:
#  a) Microsoft single sign-on (default): their own account, through the app above.
#  b) A service principal: their organisation's tenant ID, client ID and client secret,
#     entered once and stored encrypted. Queries then run as that app, which must be added
#     to their Fabric workspaces ("Service principals can use Fabric APIs" switched on).

# --- Databricks (defaults only) ---
# Each person enters THEIR OWN workspace URL in Add a new connection and signs in with:
#  a) Microsoft single sign-on (default; Azure Databricks), through the app above, or
#  b) Databricks OAuth (any cloud): an App connection in their Databricks ACCOUNT console with
#     redirect URI <PUBLIC_BASE_URL>/auth/platform/databricks/callback and scopes
#     all-apis, offline_access; they enter its client ID (and secret, if any).
# These only pre-fill the form (and offer this server's own Databricks OAuth app).
# DATABRICKS_HOST: e.g. https://adb-1234567890123456.7.azuredatabricks.net
# No personal access tokens are ever stored.
DATABRICKS_HOST=
DATABRICKS_OAUTH_CLIENT_ID=
DATABRICKS_OAUTH_CLIENT_SECRET=

# --- Snowflake (defaults only; README section 7.4) ---
# Each person enters THEIR OWN Snowflake account in Add a new connection and signs in with:
#  a) Microsoft single sign-on (default): Snowflake External OAuth trusting their Entra
#     tenant; they enter the Entra scope of their role (api://<id>/session:scope:<role>).
#  b) Snowflake OAuth (code + PKCE): a custom OAuth security integration in their account,
#     redirect URI <PUBLIC_BASE_URL>/auth/platform/snowflake/callback; they enter its client
#     ID and secret (stored encrypted) and, optionally, the one role to use.
# No Snowflake password or key is ever stored. These only pre-fill the form:
# SNOWFLAKE_ACCOUNT: the account identifier, e.g. myorg-myaccount (no https://).
SNOWFLAKE_ACCOUNT=
# This server's own Snowflake OAuth integration, for SNOWFLAKE_ACCOUNT only.
SNOWFLAKE_OAUTH_CLIENT_ID=
SNOWFLAKE_OAUTH_CLIENT_SECRET=
# The default role for Snowflake OAuth, e.g. ANALYST. Not SYSADMIN / ACCOUNTADMIN.
SNOWFLAKE_ROLE=
# The default Entra scope for External OAuth, e.g.
#    api://<snowflake resource app id>/session:scope:analyst   ("any role" is refused)
SNOWFLAKE_ENTRA_SCOPE=

# --- Tool calls ---
# Worker threads per data platform, per copy of the service.
PLATFORM_THREADS=16
# Calls one person may have running at once.
CALLS_PER_PERSON=2
# How long a call waits for a free thread before answering "busy, retry".
BUSY_WAIT_SECONDS=10
# How long a query may run before the caller gets a timeout.
QUERY_TIMEOUT_SECONDS=60
# How long signing in to a data platform may take.
PLATFORM_LOGIN_TIMEOUT_SECONDS=30
# Fabric reuses warehouse connections: idle ones close after this many seconds,
# and none lives longer than the max age (kept below an access token's hour).
FABRIC_CONNECTION_IDLE_SECONDS=300
FABRIC_CONNECTION_MAX_AGE_SECONDS=2700
# Rows returned when Claude doesn't say, and the most it may ask for.
DEFAULT_MAX_ROWS=100
MAX_ROWS_LIMIT=2000
# Size cap on one tool answer, so a wide result can't flood Claude's context.
MAX_RESULT_CHARS=60000
# Where the /setup page's "Add to Claude" button opens Claude's connector settings
# (Settings -> Connectors -> Add custom connector). The connector address itself is
# always PUBLIC_BASE_URL + /mcp; Claude has no supported way to pre-fill it, so the
# page offers a Copy button and the paste-and-add steps.
# CLAUDE_CONNECTORS_URL=https://claude.ai/settings/connectors

# Where the setup's last page sends people to start chatting ("Open Claude") when setup
# was done outside Claude's sign-in. Inside it, Finish returns through Claude's own callback.
# CLAUDE_CHAT_URL=https://claude.ai/new

# The built React app (run `npm run build` in frontend/). Empty = frontend/dist in the
# project folder.
# FRONTEND_DIR=

# Entering the Microsoft app in the setup UI before anyone is an admin: whether the
# operator's setup code is needed. Unset = needed everywhere except APP_ENV=dev (there the
# first person may, until the app is in use).
# SETUP_CODE_REQUIRED=true
